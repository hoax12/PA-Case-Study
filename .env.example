@"
# Claude API. Leave blank for fixture/offline mode.
ANTHROPIC_API_KEY=

# Model used for live document reading/extraction.
LLM_MODEL=claude-opus-5

# auto = Claude when a key is available, otherwise fixture mode.
# Accepted values: auto, claude, fixture
EXTRACTION_PROVIDER=auto

# Local persistence.
APP_DB_PATH=data/review.db
MAX_UPLOAD_MB=12

# Reviewed payer policy registry.
POLICIES_DIR=knowledge/policies

# Minimum confidence for provisional affirmation.
AUTO_AFFIRM_THRESHOLD=0.7
"@ | Set-Content .env.example -Encoding utf8