# Gemini Developer API mode (recommended for the live demo)
# Never commit a real key. Copy this file to .env and add the key there.
GOOGLE_API_KEY=your-google-api-key
GOOGLE_GENAI_USE_ENTERPRISE=FALSE

# Both the ADK orchestration model and the OCR/NER provider are configurable.
ADK_MODEL=gemini-3.5-flash-lite
EXTRACTION_MODEL=gemini-3.5-flash-lite

# auto: use Gemini when GOOGLE_API_KEY is present, otherwise labeled fixture mode.
# Accepted values: auto, gemini, fixture
EXTRACTION_PROVIDER=auto

# Local persistence. These defaults stay inside the repository.
APP_DB_PATH=data/review.db
ADK_DB_PATH=data/adk_sessions.db
MAX_UPLOAD_MB=12

# Local guideline knowledge base and retrieval.
GUIDELINE_PDF_PATH=knowledge/source/BariatricSurgery.pdf
GUIDELINE_INDEX_DIR=knowledge/index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=8
RAG_MIN_SCORE=0.22
